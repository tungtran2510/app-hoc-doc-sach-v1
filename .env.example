# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG CHO APP ĐỌC SÁCH (QBIZ BOOKS)
# Sao chép tệp này thành .env.local và điền các khóa tương ứng
# ==============================================================================

# 1. THÔNG SỐ CƠ SỞ DỮ LIỆU SUPABASE (Bắt buộc)
# Tạo dự án mới tại https://database.new -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. KHÔNG GIAN LÀM VIỆC (WORKSPACE)
# Mặc định cho app đọc sách: book_platform
APP_WORKSPACE_ID=book_platform
NEXT_PUBLIC_APP_WORKSPACE_ID=book_platform

# 3. BẢO MẬT & QUẢN TRỊ VIÊN TỐI CAO
# Mật khẩu quản trị viên cấp cao (tối thiểu 8 ký tự, gồm chữ hoa, thường, số, ký tự đặc biệt)
ADMIN_PASSWORD=YourStrongAdminPasswordHere!
# Khóa ký token phiên làm việc (chuỗi ngẫu nhiên dài 64 ký tự hex)
ADMIN_SECRET=your_super_long_random_admin_secret_string_here_64_chars

# 4. TRỢ LÝ AI (Tùy chọn)
GEMINI_API_KEY=AIzaSy...
DEEPSEEK_API_KEY=sk-...
